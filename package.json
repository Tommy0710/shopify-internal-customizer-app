{
  "name": "shopify-custom-product-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"next,shopify\" -c \"cyan,magenta\" \"next dev\" \"shopify app dev --skip-dependencies-installation\"",
    "dev:app": "next dev",
    "dev:shopify": "shopify app dev --skip-dependencies-installation",
    "build": "prisma generate && npm run bundle:extension && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs",
    "bundle:extension": "node scripts/bundle-extension.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "shopify:dev": "shopify app dev --skip-dependencies-installation",
    "shopify:deploy": "shopify app deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@prisma/client": "^5.21.1",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "@shopify/shopify-api": "^14.0.1",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "preact": "^10.29.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@shopify/cli": "^3.94.3",
    "@shopify/theme": "^3.58.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
